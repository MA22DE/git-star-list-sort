# Copy to .env and fill in. .env is gitignored and never committed.
#
# Needed only by `git-star-list-sort-describe`, which expands your GitHub List
# titles into descriptions. The classifier itself needs no OpenRouter key.
OPENROUTER_API_KEY=

# Optional: override the model used for description generation.
# OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash